# Rudhabot production environment.
# Copy this file to `.env` next to main.py (it's loaded at startup and is gitignored: never commit it), then fill in
# the two secrets. Every other value below is what the bot uses today, written out so production is explicit.
# Variables already set in the real environment win over this file.

# ============================================================== secrets (fill these in)
DISCORD_TOKEN=
# Optional: without it, /ask answers from the local docs only and match recaps are skipped.
OPENAI_API_KEY=

# ============================================================== runtime
# INFO for production; DEBUG for troubleshooting, WARNING for quieter logs.
RUDHABOT_LOG_LEVEL=INFO
# Folder for every data file (data.json, bank.json, ledger.jsonl, tcg.json, ...). Leave unset to keep using the
# working directory, where the existing files are. If you set it, MOVE THE EXISTING FILES THERE FIRST, or the bot
# starts with an empty economy.
# RUDHABOT_DATA_DIR=/srv/rudhabot/data

# ============================================================== channels
RUDHABOT_NOTIFICATIONS_CHANNEL_ID=1215241240539431033   # loan notices (warnings, auto-pay, bankruptcy)
RUDHABOT_AUDIT_CHANNEL_ID=1215240269377830943           # economy audit log + banker actions
RUDHABOT_REVIEW_CHANNEL_ID=1215240269377830943          # Clairvoyance review signals (unset = the audit channel)
RUDHABOT_LOTTERY_CHANNEL_ID=1419303864326295608         # jackpot announcements
RUDHABOT_BIRTHDAYS_CHANNEL_ID=1215241240539431033       # birthday greetings and cake deliveries

# ============================================================== roles
RUDHABOT_ADMIN_ROLE_ID=1142722971606200460              # admin commands (members with Administrator always count)
RUDHABOT_BANKER_ROLE_ID=1566271529245999255             # /banker, /audit, /review
RUDHABOT_BANKRUPT_ROLE_ID=1395412495254159371           # given on bankruptcy, removed by /banker loan-unban

# ============================================================== OpenAI assistant (/ask, @mentions, match recaps)
RUDHABOT_LLM_ENABLED=1
RUDHABOT_LLM_MODEL=gpt-5.4-mini
RUDHABOT_LLM_REASONING_EFFORT=low                       # low | medium | high (gpt-5* / o* models)
RUDHABOT_LLM_TIMEOUT_S=30
RUDHABOT_LLM_MAX_OUTPUT_TOKENS=2500                     # includes the model's reasoning tokens
RUDHABOT_LLM_PER_USER_PER_HOUR=12                       # rate limits
RUDHABOT_LLM_PER_GUILD_PER_HOUR=120
RUDHABOT_LLM_DAILY_BUDGET=800                           # max model calls per day, across the bot
RUDHABOT_CHRONICLE_ENABLED=1                            # narrated recap after a Cloudfall match

# ============================================================== Clairvoyance (in-house ML)
CLAIRVOYANCE_ENABLED=1
# Pin a model version; unset = the manifest's current one (clairvoyance-v2). Roll back with oracle-v1.
# CLAIRVOYANCE_VERSION=clairvoyance-v2
# Where the model files live; unset = the repo's models/ folder.
# RUDHABOT_MODELS_DIR=/srv/rudhabot/models

# ============================================================== Cloudfall TCG timers (seconds)
TCG_TURN_TIMEOUT_S=600                                  # duels: idle time before a safe default move is made
TCG_MAX_TIMEOUTS=3                                      # duels: timeouts in a row before a forfeit
TCG_PRACTICE_IDLE_S=86400                               # practice vs the AI: abandoned matches are cancelled after this
