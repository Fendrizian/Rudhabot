# Copy to .env next to main.py (it is loaded at startup; never commit it), or export these in your shell.
DISCORD_TOKEN=replace-with-your-bot-token

# --- OpenAI (optional): /ask and match recaps fall back to local docs without it ---
OPENAI_API_KEY=
RUDHABOT_LLM_ENABLED=1
RUDHABOT_LLM_MODEL=gpt-5.4-mini
# RUDHABOT_LLM_REASONING_EFFORT=low
# RUDHABOT_LLM_PER_USER_PER_HOUR=12
# RUDHABOT_LLM_PER_GUILD_PER_HOUR=120
# RUDHABOT_LLM_DAILY_BUDGET=800

# --- In-house Oracle model ---
ORACLE_ENABLED=1
# ORACLE_VERSION=oracle-v1          # pin / roll back a model version
# RUDHABOT_MODELS_DIR=/path/to/models

# --- Cloudfall timers (seconds) ---
# TCG_TURN_TIMEOUT_S=600       # duels: idle time before a safe default move is made
# TCG_MAX_TIMEOUTS=3           # duels: timeouts in a row before forfeiting
# TCG_PRACTICE_IDLE_S=86400    # practice: no turn timer; abandoned matches are cancelled after this
